#include "BasePassConstants.lsi"

struct VSInput
{
    [[vk::location(0)]] float3 Position : POSITION;
    [[vk::location(1)]] float3 Color : COLOR0;
    [[vk::location(2)]] float2 UV : TEXCOORD0;
    [[vk::location(3)]] float3 Normal : NORMAL0;
};

struct VSOutput
{
    float4 Position : SV_Position;
    [[vk::location(0)]] float3 Color : COLOR0;
    [[vk::location(1)]] float2 UV : TEXCOORD0;
    [[vk::location(2)]] float3 WorldNormal : NORMAL0;
};

VSOutput MainVS(VSInput input)
{
    VSOutput output;
    const float4 local = float4(input.Position, 1.0);
    output.Position = float4(
        dot(ObjectConstants.LocalToClipRow0, local),
        dot(ObjectConstants.LocalToClipRow1, local),
        dot(ObjectConstants.LocalToClipRow2, local),
        dot(ObjectConstants.LocalToClipRow3, local));
    output.Color = input.Color;
    output.UV = input.UV;
    output.WorldNormal = float3(
        dot(ObjectConstants.NormalToWorldRow0.xyz, input.Normal),
        dot(ObjectConstants.NormalToWorldRow1.xyz, input.Normal),
        dot(ObjectConstants.NormalToWorldRow2.xyz, input.Normal));
    return output;
}
