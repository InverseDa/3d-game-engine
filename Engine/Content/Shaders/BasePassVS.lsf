struct FBasePassConstants
{
    row_major float4x4 LocalToClip;
    float4 BaseColor;
};

[[vk::push_constant]]
ConstantBuffer<FBasePassConstants> ObjectConstants;

struct VSInput
{
    [[vk::location(0)]] float3 Position : POSITION;
    [[vk::location(1)]] float3 Color : COLOR0;
};

struct VSOutput
{
    float4 Position : SV_Position;
    [[vk::location(0)]] float3 Color : COLOR0;
};

VSOutput MainVS(VSInput input)
{
    VSOutput output;
    output.Position = mul(ObjectConstants.LocalToClip, float4(input.Position, 1.0));
    output.Color = input.Color;
    return output;
}
