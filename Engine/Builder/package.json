{
  "name": "@limitless/builder",
  "version": "0.1.0",
  "description": "Limitless Engine build system",
  "type": "module",
  "bin": {
    "limitless-builder": "./Source/Cli/CommandLine.ts"
  },
  "scripts": {
    "test": "node --no-warnings --experimental-strip-types --test Tests/TargetDescriptor.test.ts Tests/TestProgramTarget.test.ts Tests/CustomActions.test.ts Tests/EditorDllLinkGraph.test.ts Tests/CppGovernance.test.ts && node --no-warnings --experimental-strip-types Source/Governance/CheckCppGovernance.ts",
    "test:governance": "node --no-warnings --experimental-strip-types Source/Governance/CheckCppGovernance.ts",
    "test:integration": "node --no-warnings --experimental-strip-types --test Tests/TestTarget.integration.test.ts Tests/CustomActions.integration.test.ts",
    "list:modules": "node --experimental-strip-types Source/Cli/CommandLine.ts list modules",
    "list:targets": "node --experimental-strip-types Source/Cli/CommandLine.ts list targets",
    "help": "node --experimental-strip-types Source/Cli/CommandLine.ts help"
  },
  "engines": {
    "node": ">=22.6"
  }
}
